// Schema da API comercial multi-tenant.
//
// Regra de isolamento: toda tabela com dados comerciais carrega `tenantId`.
// Os repositórios sempre filtram por ele e as chaves únicas de negócio
// (slug, SKU, número do pedido, idempotência) são compostas com o tenant.
// Ver README > Multi-tenancy.
//
// Dinheiro: Decimal(12, 2). A aplicação converte para centavos inteiros
// (src/shared/money.ts) e nunca usa ponto flutuante para valores.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Identidade e lojas ─────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum MemberRole {
  OWNER
  ADMIN
  OPERATOR
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  name            String
  passwordHash    String
  isActive        Boolean   @default(true)
  // Pode criar novas lojas na plataforma (POST /tenants).
  isPlatformAdmin Boolean   @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships   Membership[]
  refreshTokens RefreshToken[]
}

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  slug      String       @unique
  name      String
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  settings             TenantSettings?
  memberships          Membership[]
  categories           Category[]
  products             Product[]
  variants             ProductVariant[]
  images               ProductImage[]
  stockMovements       StockMovement[]
  catalogs             Catalog[]
  catalogProducts      CatalogProduct[]
  catalogLinks         CatalogLink[]
  customers            Customer[]
  addresses            Address[]
  orders               Order[]
  orderItems           OrderItem[]
  orderStatusHistory   OrderStatusHistory[]
  payments             Payment[]
  paymentEvents        PaymentEvent[]
  financeCategories    FinanceCategory[]
  financeTransactions  FinancialTransaction[]
}

enum ShippingMode {
  FLAT_RATE
  FREE
}

model TenantSettings {
  tenantId                 String       @id @db.Uuid
  currency                 String       @default("BRL") @db.Char(3)
  orderNumberPrefix        String       @default("") @db.VarChar(8)
  shippingMode             ShippingMode @default(FLAT_RATE)
  shippingFlatRate         Decimal      @default(0) @db.Decimal(12, 2)
  // Frete grátis a partir deste subtotal (opcional).
  freeShippingThreshold    Decimal?     @db.Decimal(12, 2)
  // Tempo máximo que um pedido aguarda pagamento antes de expirar e devolver estoque.
  pendingPaymentTtlMinutes Int          @default(60)
  lowStockThreshold        Int          @default(3)
  contactEmail             String?
  contactPhone             String?
  termsUrl                 String?
  updatedAt                DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Membership {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @db.Uuid
  tenantId  String     @db.Uuid
  role      MemberRole
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  // SHA-256 do token opaco; o valor em claro só existe no cookie do cliente.
  tokenHash  String    @unique
  // Tokens rotacionados compartilham a família; reuso de um token antigo revoga a família inteira.
  familyId   String    @db.Uuid
  expiresAt  DateTime
  revokedAt  DateTime?
  rotatedAt  DateTime?
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

// ───────────────────────────── Produtos e estoque ─────────────────────────────

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  parentId    String?  @db.Uuid
  name        String
  slug        String
  description String?
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([tenantId, slug])
  @@index([tenantId, isActive, position])
}

model Product {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  categoryId     String?   @db.Uuid
  name           String
  slug           String
  description    String    @default("")
  // Linha comercial livre (ex.: "gi", "no-gi"); a API não conhece valores fixos.
  line           String?
  tags           String[]  @default([])
  price          Decimal   @db.Decimal(12, 2)
  salePrice      Decimal?  @db.Decimal(12, 2)
  sizeGuide      String?
  shippingInfo   String?
  isActive       Boolean   @default(true)
  isFeatured     Boolean   @default(false)
  releasedAt     DateTime?
  // Desativação lógica: produtos removidos continuam referenciados por pedidos antigos.
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants        ProductVariant[]
  images          ProductImage[]
  catalogProducts CatalogProduct[]
  orderItems      OrderItem[]

  @@unique([tenantId, slug])
  @@index([tenantId, isActive, deletedAt])
  @@index([tenantId, categoryId])
  @@index([tenantId, line])
}

model ProductVariant {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  productId String   @db.Uuid
  sku       String
  size      String?
  color     String?
  colorHex  String?  @db.VarChar(7)
  // Sobrepõe o preço do produto quando informado.
  price     Decimal? @db.Decimal(12, 2)
  salePrice Decimal? @db.Decimal(12, 2)
  // CHECK (stock >= 0) é criado na migration: a baixa concorrente nunca deixa estoque negativo.
  stock     Int      @default(0)
  isActive  Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  images         ProductImage[]
  stockMovements StockMovement[]
  orderItems     OrderItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, productId])
  @@index([tenantId, stock])
}

model ProductImage {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  productId   String   @db.Uuid
  variantId   String?  @db.Uuid
  // Caminho no bucket: {tenantId}/products/{productId}/{uuid}.{ext}
  storagePath String
  url         String
  alt         String   @default("")
  position    Int      @default(0)
  isPrimary   Boolean  @default(false)
  mimeType    String
  sizeBytes   Int
  createdAt   DateTime @default(now())

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([tenantId, productId, position])
}

enum StockMovementType {
  // Entrada manual (compra de fornecedor, produção).
  INBOUND
  // Saída manual (perda, brinde, avaria).
  OUTBOUND
  // Ajuste de inventário para um saldo absoluto.
  ADJUSTMENT
  // Baixa por pedido criado.
  SALE
  // Devolução ao estoque por pedido cancelado ou expirado.
  RELEASE
  // Retorno físico de um pedido entregue.
  RETURN
}

model StockMovement {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @db.Uuid
  variantId    String            @db.Uuid
  type         StockMovementType
  // Variação com sinal aplicada ao saldo (+ entrada, − saída).
  quantity     Int
  balanceAfter Int
  reason       String
  orderId      String?           @db.Uuid
  userId       String?           @db.Uuid
  // Origem quando não há usuário: "checkout", "payment-webhook", "expiration-job"...
  source       String
  createdAt    DateTime          @default(now())

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  order   Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([tenantId, variantId, createdAt])
  @@index([tenantId, orderId])
}

// ───────────────────────────── Catálogos e links ─────────────────────────────

enum CatalogType {
  GENERAL
  COLLECTION
  CAMPAIGN
}

model Catalog {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String      @db.Uuid
  name         String
  slug         String
  description  String      @default("")
  type         CatalogType @default(COLLECTION)
  // Público: acessível por slug. Privado: só por link exclusivo.
  isPublic     Boolean     @default(true)
  isActive     Boolean     @default(true)
  heroImageUrl String?
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products CatalogProduct[]
  links    CatalogLink[]
  orders   Order[]

  @@unique([tenantId, slug])
  @@index([tenantId, isActive])
}

model CatalogProduct {
  tenantId  String @db.Uuid
  catalogId String @db.Uuid
  productId String @db.Uuid
  position  Int    @default(0)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  catalog Catalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([catalogId, productId])
  @@index([tenantId, productId])
}

model CatalogLink {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  catalogId   String    @db.Uuid
  // 32 bytes aleatórios em base64url. Não é credencial administrativa.
  token       String    @unique
  label       String
  expiresAt   DateTime?
  maxUses     Int?
  useCount    Int       @default(0)
  isActive    Boolean   @default(true)
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  catalog Catalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@index([tenantId, catalogId])
}

// ───────────────────────────── Clientes e pedidos ─────────────────────────────

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  // Telefone normalizado (só dígitos) identifica o cliente dentro da loja.
  phone     String
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addresses Address[]
  orders    Order[]

  @@unique([tenantId, phone])
  @@index([tenantId, email])
}

model Address {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  customerId String   @db.Uuid
  zipCode    String   @db.VarChar(8)
  street     String
  number     String
  complement String?
  district   String
  city       String
  state      String   @db.Char(2)
  createdAt  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId])
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
  EXPIRED
  RETURNED
}

enum OrderSource {
  STOREFRONT
  CATALOG
  CATALOG_LINK
  ADMIN
}

enum PaymentMethod {
  PIX
  CARD
}

model Order {
  id                String        @id @default(uuid()) @db.Uuid
  tenantId          String        @db.Uuid
  // Número público não sequencial (não permite enumerar pedidos).
  number            String
  customerId        String        @db.Uuid
  status            OrderStatus   @default(PENDING_PAYMENT)
  source            OrderSource   @default(STOREFRONT)
  catalogId         String?       @db.Uuid
  catalogLinkId     String?       @db.Uuid
  paymentMethod     PaymentMethod
  currency          String        @db.Char(3)
  subtotal          Decimal       @db.Decimal(12, 2)
  shippingTotal     Decimal       @db.Decimal(12, 2)
  discountTotal     Decimal       @default(0) @db.Decimal(12, 2)
  total             Decimal       @db.Decimal(12, 2)
  // Snapshot do endereço de entrega no momento da compra.
  shipZipCode       String        @db.VarChar(8)
  shipStreet        String
  shipNumber        String
  shipComplement    String?
  shipDistrict      String
  shipCity          String
  shipState         String        @db.Char(2)
  customerName      String
  customerPhone     String
  customerEmail     String?
  notes             String?
  idempotencyKey    String
  // SHA-256 do token de acompanhamento entregue ao comprador.
  trackingTokenHash String
  termsAcceptedAt   DateTime
  paymentExpiresAt  DateTime?
  shippingCarrier   String?
  trackingCode      String?
  paidAt            DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  catalog        Catalog?             @relation(fields: [catalogId], references: [id], onDelete: SetNull)
  catalogLink    CatalogLink?         @relation(fields: [catalogLinkId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  payments       Payment[]
  stockMovements StockMovement[]
  transactions   FinancialTransaction[]

  @@unique([tenantId, number])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, customerId])
  @@index([status, paymentExpiresAt])
}

model OrderItem {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @db.Uuid
  orderId      String  @db.Uuid
  productId    String? @db.Uuid
  variantId    String? @db.Uuid
  // Snapshots: preservam o histórico comercial após alterações no produto.
  productName  String
  sku          String
  variantLabel String
  size         String?
  color        String?
  unitPrice    Decimal @db.Decimal(12, 2)
  quantity     Int
  lineTotal    Decimal @db.Decimal(12, 2)

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([tenantId, orderId])
}

model OrderStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @db.Uuid
  orderId    String       @db.Uuid
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  userId     String?      @db.Uuid
  source     String
  createdAt  DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId, createdAt])
  @@index([tenantId, createdAt])
}

// ───────────────────────────── Pagamentos ─────────────────────────────

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
  REFUNDED
}

model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @db.Uuid
  orderId     String        @db.Uuid
  provider    String
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  amount      Decimal       @db.Decimal(12, 2)
  // Id da preferência/checkout no provedor e id do pagamento efetivo.
  externalReference String  @unique
  checkoutId  String?
  externalId  String?
  checkoutUrl String?
  rawStatus   String?
  approvedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order       Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events      PaymentEvent[]
  transaction FinancialTransaction?

  @@unique([provider, externalId])
  @@index([tenantId, orderId])
  @@index([tenantId, status])
}

model PaymentEvent {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String?   @db.Uuid
  paymentId   String?   @db.Uuid
  provider    String
  // Chave de idempotência do evento (id da notificação no provedor + estado).
  eventKey    String
  type        String
  payload     Json
  result      String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  tenant  Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, eventKey])
  @@index([tenantId, createdAt])
}

// ───────────────────────────── Financeiro ─────────────────────────────

enum FinanceKind {
  INCOME
  EXPENSE
}

enum FinanceStatus {
  PENDING
  PAID
  CANCELLED
}

model FinanceCategory {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @db.Uuid
  name      String
  kind      FinanceKind
  isSystem  Boolean     @default(false)
  createdAt DateTime    @default(now())

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions FinancialTransaction[]

  @@unique([tenantId, kind, name])
}

model FinancialTransaction {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @db.Uuid
  kind           FinanceKind
  categoryId     String?       @db.Uuid
  description    String
  amount         Decimal       @db.Decimal(12, 2)
  // Competência: a que período o fato pertence. Recebimento/pagamento: quando o dinheiro moveu.
  competenceDate DateTime      @db.Date
  paidAt         DateTime?
  status         FinanceStatus @default(PENDING)
  paymentMethod  String?
  orderId        String?       @db.Uuid
  // Uma receita por pagamento aprovado: webhooks repetidos não duplicam a receita.
  paymentId      String?       @unique @db.Uuid
  createdById    String?       @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  order    Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  payment  Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([tenantId, kind, competenceDate])
  @@index([tenantId, kind, paidAt])
}
