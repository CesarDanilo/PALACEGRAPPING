# ── Servidor ─────────────────────────────────────────────
NODE_ENV=development
PORT=3350
# URL pública desta API (usada em notification_url de pagamentos).
PUBLIC_API_URL=http://localhost:3350
# Origens autorizadas a chamar a API com credenciais (separadas por vírgula).
CORS_ORIGINS=http://localhost:5190
LOG_LEVEL=info
# Proxies confiáveis à frente da API (1 por padrão em produção; 2 com Vercel → Render).
# TRUST_PROXY_HOPS=2
# Expõe /docs (Swagger UI). Recomenda-se false em produção.
ENABLE_API_DOCS=true

# ── Banco (Supabase PostgreSQL) ──────────────────────────
# Runtime: pooler do Supabase (Supavisor, modo transaction, porta 6543).
#   postgresql://postgres.<ref>:<senha>@aws-0-<região>.pooler.supabase.com:6543/postgres
# Desenvolvimento local com docker compose:
DATABASE_URL=postgresql://commerce:commerce@localhost:5452/commerce
# Migrations (Prisma CLI): conexão direta, porta 5432.
#   postgresql://postgres:<senha-url-encoded>@db.<ref>.supabase.co:5432/postgres?uselibpqcompat=true&sslmode=require
#   (caracteres especiais da senha devem ser codificados, ex.: @ vira %40)
DIRECT_URL=postgresql://commerce:commerce@localhost:5452/commerce
# Usado apenas por `npm run test:integration` (o banco é recriado a cada execução).
TEST_DATABASE_URL=postgresql://commerce:commerce@localhost:5452/commerce_test

# ── Autenticação ─────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32+-caracteres
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# true quando a API é servida por HTTPS (cookies Secure). Obrigatório em produção.
COOKIE_SECURE=false
# lax (mesmo site) ou none (loja e API em sites diferentes; exige COOKIE_SECURE=true).
COOKIE_SAMESITE=lax
# Tentativas de login por IP a cada 15 minutos.
LOGIN_RATE_LIMIT=10

# ── Supabase Storage ─────────────────────────────────────
# Sem estas variáveis o upload de imagens responde 503 (não configurado).
SUPABASE_URL=
# Chave service_role: SOMENTE no backend. Nunca exponha no frontend.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images
UPLOAD_MAX_BYTES=5242880

# ── Pagamentos (Mercado Pago) ────────────────────────────
# Sem MERCADOPAGO_ACCESS_TOKEN o checkout cria o pedido, mas não gera cobrança.
MERCADOPAGO_ACCESS_TOKEN=
# Assinatura secreta das notificações (Suas integrações > Webhooks).
MERCADOPAGO_WEBHOOK_SECRET=
# Para onde o comprador volta após o checkout do provedor.
STOREFRONT_URL=http://localhost:5190

# ── Tarefas ──────────────────────────────────────────────
# Intervalo da varredura que expira pedidos sem pagamento (0 desativa).
EXPIRATION_SWEEP_SECONDS=60
