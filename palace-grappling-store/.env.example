# URL base da commerce-api. Vazio = mesma origem (em dev o Vite faz proxy de /api).
VITE_API_URL=
# ── Identidade da loja (troque para revender o sistema; exige novo build) ──
# Nome completo, usado no título da página, rodapé e selos.
VITE_BRAND_NAME=Palace Grappling
# Logotipo: palavra de destaque e linha menor (padrão: 1ª palavra / resto do nome).
VITE_BRAND_SHORT=PALACE
VITE_BRAND_SUBTITLE=GRAPPLING
# Descrição curta (buscadores e compartilhamento).
VITE_BRAND_DESCRIPTION=Palace Grappling: kimonos, rash guards e equipamentos premium para Jiu-Jitsu e grappling.
VITE_BRAND_SINCE=2026
# Rótulo ao lado do nome no painel.
VITE_ADMIN_LABEL=ADMIN

# Slug público da loja na API (cabeçalho X-Store).
VITE_STORE_SLUG=palace-grappling
# Somente desenvolvimento: para onde o proxy do Vite encaminha /api.
DEV_API_PROXY_TARGET=http://localhost:3350
